{
    "name": "kostasch/greeklish",
    "description": "Convert Greek text to greeklish (latin) and generate URL friendly slugs for Laravel.",
    "keywords": [
        "kostasch",
        "greeklish",
        "greek",
        "transliteration",
        "slug",
        "laravel"
    ],
    "homepage": "https://github.com/kostasxyz/greeklish",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kostas Charalampidis",
            "email": "xyzkostas@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Kostasch\\Greeklish\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kostasch\\Greeklish\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kostasch\\Greeklish\\GreeklishServiceProvider"
            ],
            "aliases": {
                "Greeklish": "Kostasch\\Greeklish\\Facades\\Greeklish"
            }
        }
    }
}
